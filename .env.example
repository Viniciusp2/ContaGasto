# Copie pra .env.local (local) ou cadastre na Vercel (Settings > Environment Variables).

# Banco na nuvem (Neon). Sem ela, o app usa o banco local em .data/pglite.
DATABASE_URL=

# Login com senha única. Em produção, sem as duas, ninguém entra.
BOLSO_SENHA=
# Segredo pra assinar a sessão: 32+ caracteres aleatórios. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOLSO_SEGREDO=

# Notificações (Avisos). Opcionais: as chaves nascem sozinhas no banco.
# CRON_SECRET: se existir, só o agendador da Vercel chama /api/avisos/* (a Vercel manda sozinha). Recomendado.
# CRON_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Assistente com IA (Mais, Assistente). Escolha a IA aqui; sem a chave dela, o assistente avisa que não
# está ligado. Detalhes em src/lib/ia/config.ts.
#   gemini      (padrão) chave grátis em aistudio.google.com            -> GEMINI_API_KEY
#   groq        chave grátis em console.groq.com                       -> GROQ_API_KEY
#   openrouter  modelos grátis em openrouter.ai                        -> OPENROUTER_API_KEY
#   claude      pago à parte da assinatura do Claude, platform.claude.com -> ANTHROPIC_API_KEY
#   compativel  qualquer IA no formato de chat da OpenAI: IA_URL + IA_MODELO + IA_CHAVE
IA_PROVEDOR=gemini
GEMINI_API_KEY=
# Opcionais: trocar o modelo padrão do provedor, o endereço ou usar uma chave só pra qualquer um
# IA_MODELO=
# IA_URL=
# IA_CHAVE=
