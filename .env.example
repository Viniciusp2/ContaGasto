# Copie pra .env.local (local) ou cadastre na Vercel (Settings > Environment Variables).

# Banco na nuvem (Neon). Sem ela, o app usa o banco local em .data/pglite.
DATABASE_URL=

# Login com senha única. Em produção, sem as duas, ninguém entra.
BOLSO_SENHA=
# Segredo pra assinar a sessão: 32+ caracteres aleatórios. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOLSO_SEGREDO=

# Assistente com IA (Mais, Assistente). Crie em platform.claude.com, API keys. É paga à parte
# da assinatura do Claude (créditos pré-pagos). Sem ela, o assistente avisa que não está ligado.
ANTHROPIC_API_KEY=
