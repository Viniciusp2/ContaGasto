# Copie pra .env.local (local) ou cadastre na Vercel (Settings > Environment Variables).

# Banco na nuvem (Neon). Sem ela, o app usa o banco local em .data/pglite.
DATABASE_URL=

# Login com senha única. Em produção é obrigatória: sem ela (e sem senha trocada no app), ninguém entra.
# No computador, sem ela, a senha inicial é 1234.
BOLSO_SENHA=
# Segredo pra assinar a sessão: 32+ caracteres aleatórios. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOLSO_SEGREDO=

# Notificações (Avisos). Opcionais: as chaves nascem sozinhas no banco.
# CRON_SECRET: obrigatório em produção. Só o agendador da Vercel chama /api/avisos/* (a Vercel manda sozinha).
# CRON_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Assistente com IA (Mais, Assistente). Escolha a IA aqui; sem a chave dela, o assistente avisa que não
# está ligado. Detalhes em src/lib/ia/config.ts.
#   gemini      (padrão) chave grátis em aistudio.google.com            -> GEMINI_API_KEY
#   groq        chave grátis em console.groq.com                       -> GROQ_API_KEY
#   openrouter  modelos grátis em openrouter.ai                        -> OPENROUTER_API_KEY
#   claude      Anthropic, pago por uso, console da Anthropic           -> ANTHROPIC_API_KEY
#   compativel  qualquer IA no formato de chat da OpenAI: IA_URL + IA_MODELO + IA_CHAVE
IA_PROVEDOR=gemini
GEMINI_API_KEY=
# IA reserva: responde quando a principal falha (limite grátis do dia, fora do ar). Usa só a chave própria dela.
IA_RESERVA=groq
GROQ_API_KEY=
# Opcionais: trocar o modelo padrão do provedor, o endereço ou usar uma chave só pra qualquer um
# IA_MODELO=
# IA_URL=
# IA_CHAVE=

# Modo demonstração (versão de portfólio): sem login, dados inventados só na memória, IA desligada.
# Nunca usa DATABASE_URL, mesmo que exista. Ver docs/INSTALACAO.md.
# BOLSO_DEMO=1
# Link do repositório, pro cartão "ligue com a sua própria chave" apontar pro passo a passo
# BOLSO_REPO_URL=https://github.com/seu-usuario/bolso
